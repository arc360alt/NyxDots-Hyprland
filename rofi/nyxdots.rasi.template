/*
 * GENERATED by scripts/generate-rofi-theme.py — do not edit by hand.
 * Colors come from state/config.json (or state/colors.json when wallpaper
 * theming is active) — edit those from the NyxDots Settings app instead.
 * This file is the structural template that gets the {{...}} placeholders
 * substituted in.
 */

configuration {
    modi: "drun";
    show-icons: true;
    drun-display-format: "{name}";
    disable-history: false;
}

* {
    font: "{{font}} 12";

    bg-col:        {{background}};
    bg-col-alt:    {{surface}};
    bg-selected:   {{surfaceHigh}};
    fg-col:        {{text}};
    fg-muted:      {{muted}};
    accent-col:    {{primary}};
    border-col:    {{outline}};

    background-color: transparent;
    text-color:        @fg-col;
}

window {
    transparency: "real";
    background-color: @bg-col-alt;
    border: 1px;
    border-color: @border-col;
    border-radius: 18px;
    width: 480px;
    location: center;
    anchor: center;
    padding: 16px;
}

mainbox {
    background-color: transparent;
    children: [ inputbar, listview ];
    spacing: 12px;
}

inputbar {
    background-color: @bg-col;
    text-color: @fg-col;
    border-radius: 20px;
    padding: 10px 14px;
    children: [ prompt, entry ];
    spacing: 10px;
}

prompt {
    background-color: transparent;
    text-color: @accent-col;
    text: "";
}

entry {
    background-color: transparent;
    text-color: @fg-col;
    placeholder: "search apps...";
    placeholder-color: @fg-muted;
}

listview {
    background-color: transparent;
    columns: 1;
    lines: 8;
    spacing: 4px;
    cycle: true;
    dynamic: true;
    scrollbar: false;
}

element {
    background-color: transparent;
    text-color: @fg-col;
    padding: 8px 10px;
    border-radius: 10px;
    orientation: horizontal;
    spacing: 10px;
}

element selected {
    background-color: @bg-selected;
    text-color: @accent-col;
}

element-icon {
    size: 22px;
    vertical-align: 0.5;
}

element-text {
    vertical-align: 0.5;
    text-color: inherit;
}
